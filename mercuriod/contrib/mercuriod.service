[Unit]
Description=Mercurio MQTT Broker
Documentation=https://github.com/frenzox/mercurio
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The packages create a static mercurio user, so files such as TLS keys can
# be given to it; without one, systemd allocates a dynamic user of that name
User=mercurio
Group=mercurio
DynamicUser=yes
ExecStart=/usr/bin/mercuriod --config /etc/mercurio/config.toml
# Not an ExecStartPre=: a restart stops the running broker first, so a check
# there would only repeat the start's own and compile plugins twice. Check
# before restarting instead: sudo -u mercurio mercuriod --check
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# One descriptor per client, and max_connections defaults to 10000
LimitNOFILE=65536

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Files the broker creates, such as the SQLite database and the log file,
# are readable by its user only
UMask=0077
# Writable /var/lib/mercurio for SQLite storage, despite ProtectSystem
StateDirectory=mercurio
StateDirectoryMode=0700
# /var/log/mercurio, for [logging] file
LogsDirectory=mercurio
# /run/mercurio, for Unix socket listeners and the admin socket, which the
# broker opens to the admin group itself
RuntimeDirectory=mercurio
PrivateDevices=true
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
# No MemoryDenyWriteExecute=: WebAssembly plugins are compiled to machine
# code at runtime
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Binding ports below 1024 is the only privilege the broker needs
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mercuriod

[Install]
WantedBy=multi-user.target
