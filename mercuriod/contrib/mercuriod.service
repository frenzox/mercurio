[Unit]
Description=Mercurio MQTT Broker
Documentation=https://github.com/frenzox/mercurio
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The packages create a static mercurio user, so files such as TLS keys can
# be given to it; without one, systemd allocates a dynamic user of that name
User=mercurio
Group=mercurio
DynamicUser=yes
ExecStart=/usr/bin/mercuriod --config /etc/mercurio/config.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Writable /var/lib/mercurio for SQLite storage, despite ProtectSystem
StateDirectory=mercurio
# /run/mercurio, for Unix socket listeners
RuntimeDirectory=mercurio
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

# Allow binding to privileged ports if needed
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mercuriod

[Install]
WantedBy=multi-user.target
